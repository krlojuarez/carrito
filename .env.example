# Copy to .env.local and fill in. NEXT_PUBLIC_* values are exposed to the browser (safe by design).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New-style publishable key (begins with sb_publishable_...) OR the legacy anon JWT (begins with eyJ...). Either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
# Absolute URL of the deployed site (used by the PDF report route to resolve fonts/logo).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret key — NEVER prefix with NEXT_PUBLIC. Only needed for privileged server scripts/migrations.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx
